rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Each player owns their profile and every document below it, including
    // progress, inventory, achievements, and private match history.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Signed-in players can read leaderboard entries, but only trusted server
    // code should submit or modify scores to prevent client-side cheating.
    match /leaderboards/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Remote game configuration is readable by players and writable only by
    // trusted server/admin code.
    match /gameConfig/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // New collections are private until explicitly reviewed and authorized.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
